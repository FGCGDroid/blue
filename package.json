{
  "name": "dsh-blue-team-mode",
  "version": "2.0.0-beta.13",
  "description": "CTF 网络攻防蓝队防御模式：资产盘点、告警研判、威胁狩猎、应急响应、取证分析与加固修复，内置 SQLite 事实库、独立右侧栏控制台与自主任务派发队列。",
  "license": "MIT",
  "author": "FGCGDroid",
  "contributors": [
    "FGCGDroid",
    "大肥鱼"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FGCGDroid/blue.git"
  },
  "homepage": "https://github.com/FGCGDroid/blue#readme",
  "bugs": {
    "url": "https://github.com/FGCGDroid/blue/issues"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./store": "./lib/store.js",
    "./tools": "./lib/tools.js",
    "./ui": "./lib/ui.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "presets",
    "skills",
    "scripts",
    "docs",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "DISCLOSURE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/check-compliance.mjs --selftest",
    "hooks": "node scripts/install-hooks.mjs",
    "test:decoy": "node scripts/test-decoy-server.mjs",
    "test:hunter": "node scripts/test-hunter.mjs",
    "test:ctf-defense": "node scripts/test-ctf-defense.mjs",
    "test:gateway": "node scripts/test-inline-gateway.mjs",
    "test:migration": "node scripts/test-migration.mjs",
    "test:e2e": "node scripts/test-ui-e2e.mjs",
    "test": "node scripts/test-tools.mjs && node scripts/test-ui.mjs && node scripts/test-hunter.mjs && node scripts/test-inline-gateway.mjs && node scripts/test-decoy-server.mjs && node scripts/test-migration.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "bin": {
    "dsh-blue-decoy": "scripts/decoy-server.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "blue-team",
    "ctf",
    "defense",
    "incident-response",
    "threat-hunting",
    "dfir"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.5"
  }
}
