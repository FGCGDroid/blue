[sshd]
enabled = true
maxretry = 3
findtime = 3600
bantime = 86400

[nginx-login]
enabled = true
filter = nginx-login
logpath = /var/log/nginx/access.log
maxretry = 5
findtime = 600
bantime = 3600

[nginx-scanner-ua]
enabled = true
filter = nginx-scanner-ua
logpath = /var/log/nginx/access.log
maxretry = 3
findtime = 300
bantime = 86400
